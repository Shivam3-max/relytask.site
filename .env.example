# Copy to .env and fill in. Never commit .env.

# ── Database ──────────────────────────────────────────────────
# Any MySQL (or MariaDB) works: Hostinger, a VPS, PlanetScale, RDS, or a
# local server (Laragon, XAMPP, Docker).
#
# With no DATABASE_* vars set, the app connects to 127.0.0.1:3306 as root
# with no password and a database named "relytask_site" — matching most
# local MySQL installs out of the box. Create that database once:
#   CREATE DATABASE relytask_site CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Tables are created automatically on first request — no migration step.
#
# For production, either set one connection string:
# DATABASE_URL="mysql://user:password@host:3306/dbname"
#
# ...or the discrete parts (useful when your host gives you these separately,
# e.g. Hostinger's hPanel → Databases):
# DATABASE_HOST="127.0.0.1"
# DATABASE_PORT="3306"
# DATABASE_USER="root"
# DATABASE_PASSWORD=""
# DATABASE_NAME="relytask_site"

# Max connections per instance. Shared MySQL hosting plans cap total
# concurrent connections (often 20-30), and every warm serverless instance
# opens its own pool, so keep this small in production. Default is 5.
DATABASE_POOL_MAX="5"

# Set to "true" if your host requires SSL for remote MySQL connections.
# DATABASE_SSL="true"
# Set to "false" only if the host presents a self-signed certificate.
# DATABASE_SSL_REJECT_UNAUTHORIZED="false"

# ── Admin panel ───────────────────────────────────────────────
# Signs the admin session cookie. Generate a fresh one:
#   openssl rand -hex 32
ADMIN_SECRET="change-this-to-32-plus-random-characters"

# There is no admin password env var. Accounts (email + hashed password)
# live in the AdminUser table. Create one with `npm run seed:admin --
# --email you@example.com --password "..."` (needs a shell), or insert the
# row directly with SQL — see README.md.

# ── Uploads (optional) ────────────────────────────────────────
# Leave unset locally — testimonial videos are written to public/uploads.
# On a host with a read-only filesystem (Vercel, Netlify) this is required,
# otherwise uploads will fail. Create a Blob store in the Vercel dashboard
# and it supplies the token.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
