# Copy to .env and fill in. Never commit .env.

# ── Database ──────────────────────────────────────────────────
# Any Postgres. Free options: Neon, Vercel Postgres, Supabase.
#
# For local development with nothing to install, run:
#   npm run db
# and use the URL below as-is — it starts a real Postgres (PGlite) on 5432.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"

# Connection pool size. The local PGlite server serves one connection at a
# time, so keep this at 1 for local work. On serverless, a small number (1-5)
# stops a burst of instances exhausting the database's connection limit.
# Unset means the driver default (10).
DATABASE_POOL_MAX="1"

# ── Admin panel ───────────────────────────────────────────────
# The password you type at /admin/login.
ADMIN_PASSWORD="change-this"

# Signs the admin session cookie. Generate a fresh one:
#   openssl rand -hex 32
ADMIN_SECRET="change-this-to-32-plus-random-characters"

# ── Uploads (optional) ────────────────────────────────────────
# Leave unset locally — testimonial videos are written to public/uploads.
# On a host with a read-only filesystem (Vercel, Netlify) this is required,
# otherwise uploads will fail. Create a Blob store in the Vercel dashboard
# and it supplies the token.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
