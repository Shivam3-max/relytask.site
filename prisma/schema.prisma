generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Every enquiry, tool submission and calculator result lands here.
model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name    String?
  email   String?
  phone   String?
  company String?
  message String?

  /// "contact" | "cost-estimator" | "outreach-roi" | ...
  source   String
  service  String?
  budget   String?
  timeline String?

  /// JSON blob of whatever the tool captured (inputs + computed result).
  payload String?

  /// new | contacted | qualified | won | lost
  status String  @default("new")
  score  Int     @default(0)
  notes  String?

  @@index([createdAt])
  @@index([status])
  @@index([source])
}

model CaseStudy {
  id       String  @id @default(cuid())
  slug     String  @unique
  client   String
  title    String
  category String
  industry String
  year     String
  timeline String
  liveUrl  String?
  summary  String

  challenge String
  /// JSON: string[]
  services  String
  /// JSON: string[]
  stack     String?
  /// JSON: { title, body }[]
  approach  String
  /// JSON: { value, label }[]
  metrics   String

  quoteText String?
  quoteName String?
  quoteRole String?

  seed         Int     @default(1)
  confidential Boolean @default(false)
  featured     Boolean @default(false)
  published    Boolean @default(true)
  order        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  name      String
  role      String
  company   String?

  /// Uploaded video or image, served from /uploads.
  mediaUrl  String?
  /// "video" | "image"
  mediaType String?
  /// Optional still shown before a video plays.
  posterUrl String?
  /// Aspect ratio of the media, e.g. "16/9".
  aspect    String  @default("16/9")

  published Boolean  @default(true)
  featured  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

/// Key/value store for the rate card, contact details and headline stats,
/// so the admin panel can change them without a deploy.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
